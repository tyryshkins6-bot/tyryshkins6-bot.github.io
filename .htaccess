# Изображения — кэшируем на год
/static/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/static/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/static/*.png
  Cache-Control: public, max-age=31536000, immutable
/static/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable

# Видео — тоже на год
/*.webm
  Cache-Control: public, max-age=31536000, immutable
/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# Стили и скрипты — на год, но с версиями
/static/*.css
  Cache-Control: public, max-age=31536000, immutable
/static/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML — кэшируем на 1 час (чтобы изменения подхватывались)
/*.html
  Cache-Control: public, max-age=3600